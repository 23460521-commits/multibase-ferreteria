# Puerto del Web Service
PORT=3000

# MySQL (relacional) - el puerto 3307 evita choque con el MySQL de XAMPP (3306)
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=ferreteria
MYSQL_PASSWORD=ferreteria123
MYSQL_DATABASE=ferreteria

# MongoDB (NoSQL documental) - 27018 evita choque con otro contenedor de Mongo en 27017
MONGO_URI=mongodb://localhost:27018
MONGO_DB=ferreteria

# Redis (clave-valor) - 6380 evita choque con otro Redis en 6379
REDIS_URL=redis://localhost:6380
